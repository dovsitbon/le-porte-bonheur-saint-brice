---
// Sceau rouge 福 (« bonheur »), façon tampon encreur.
import { FU_PATH } from '../data/fu-path.js';
interface Props { class?: string; anime?: boolean; titre?: string }
const { class: cls = '', anime = false, titre } = Astro.props;
const id = `rugueux-${Math.random().toString(36).slice(2, 8)}`;
---
<svg
  class:list={[cls, anime && 'sceau-anime']}
  viewBox="0 0 120 120"
  role={titre ? 'img' : undefined}
  aria-label={titre}
  aria-hidden={titre ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <filter id={id} x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="bruit" />
      <feDisplacementMap in="SourceGraphic" in2="bruit" scale="2.2" />
    </filter>
  </defs>
  <g filter={`url(#${id})`}>
    <rect x="4" y="4" width="112" height="112" rx="7" fill="#9e1b1b" />
    <rect x="10" y="10" width="100" height="100" rx="3" fill="none" stroke="#f2e8d2" stroke-width="2.2" />
    <path d={FU_PATH} transform="translate(17 17) scale(0.086)" fill="#f2e8d2" />
  </g>
</svg>
