---
const jours = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
const idx = [1, 2, 3, 4, 5, 6, 0];
---
<table class="w-full border-collapse text-[1.02rem]">
  <caption class="sr-only">Horaires d’ouverture du restaurant Le Porte Bonheur</caption>
  <thead class="sr-only"><tr><th scope="col">Jour</th><th scope="col">Midi</th><th scope="col">Soir</th></tr></thead>
  <tbody>
    {jours.map((j, i) => (
      <tr data-jour={idx[i]} class="border-b border-dotted border-encre-2/40 [&[data-aujourdhui]]:bg-laque [&[data-aujourdhui]]:text-papier">
        <th scope="row" class="py-2.5 pl-2 pr-3 text-left font-semibold">{j}<span class="sr-only" data-aujourdhui-label></span></th>
        <td class="py-2.5 px-2 tabular-nums">12h00 – 14h30</td>
        <td class="py-2.5 px-2 pr-2 text-right tabular-nums">19h00 – 22h30</td>
      </tr>
    ))}
  </tbody>
</table>
